# Copy this file to ".env" (same folder) and change the values if needed. Never commit .env.
# No usernames or passwords go here: they are read from the login details Excel file
# (see "credentialsfile" in profiles/<PROFILE>.json), with the password encrypted.

# Which file in /profiles to use (same as the Katalon execution profile)
PROFILE=default

# Optional: use a different login details file than the one in the profile
# ELCOM_CREDENTIALS_FILE=\\192.168.2.25\Common\QA\Katalon-Data\ec12-5-dev-profile - ADMIN.xlsx

# Optional: override the URLs from the profile
# ELCOM_URL=https://ec12-5.dev.elcomcms.com/cmlogin.aspx?mode=manual
# ELCOM_DOMAIN=https://ec12-5.dev.elcomcms.com/
